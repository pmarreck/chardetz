#!/usr/bin/env bash
# chardetz complete test entry point. Every required check runs from here and
# failures accumulate into the exit status. Re-enters the Nix dev shell unless
# called with --no-nix (the flake check already runs inside one).
set -u
cd "$(dirname "$0")" || exit 1
if [ "${1:-}" != "--no-nix" ]; then
	exec nix develop -c ./test --no-nix
fi

failures=0
pass() { printf '\033[32m✓\033[0m %s\n' "$1"; }
fail() { printf '\033[31m✗\033[0m %s\n%s\n' "$1" "$2"; failures=$((failures + 1)); }

# Runs a command with output captured; shows the output only on failure.
check() {
	local name=$1
	shift
	local out
	out=$("$@" 2>&1)
	local rc=$?
	if [ "$rc" -eq 0 ]; then pass "$name"; else fail "$name (exit $rc)" "$out"; fi
}

# The manifest's upstream revision must be the one flake.lock actually fetched.
pin_agreement() {
	local manifest_rev lock_rev
	manifest_rev=$(awk '$1 == "rev" { print $2 }' tools/gen_tables/manifest.txt)
	lock_rev=$(awk '/"uchardetz-src": \{/ { inblock = 1 } inblock && /"rev":/ { gsub(/[",]/, "", $2); print $2; exit }' flake.lock)
	if [ -z "$manifest_rev" ] || [ "$manifest_rev" != "$lock_rev" ]; then
		echo "manifest rev '$manifest_rev' != flake.lock uchardetz-src rev '$lock_rev'"
		return 1
	fi
}

source_available() {
	if [ -z "${CHARDETZ_UCHARDET_SRC:-}" ] || [ ! -d "$CHARDETZ_UCHARDET_SRC/src" ]; then
		echo "CHARDETZ_UCHARDET_SRC is not set to the pinned uchardetz tree"
		return 1
	fi
}

check "pinned uchardetz source available" source_available
check "manifest pin matches flake.lock" pin_agreement
check "control files match blessed hashes" sha256sum --check --quiet blessed_hashes.txt
check "zig fmt" zig fmt --check build.zig tools src
check "zig build test (ReleaseSafe, includes table freshness)" zig build test -Doptimize=ReleaseSafe

if [ "$failures" -ne 0 ]; then
	printf '\033[31m%d check(s) failed\033[0m\n' "$failures"
	exit 1
fi
printf '\033[32mall checks passed\033[0m\n'
