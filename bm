#!/usr/bin/env bash
# Benchmark suite. M1 has no detection runtime yet — the real per-function
# throughput gate (chardetz vs C++ uchardet; scaling-ratio N/2N/4N/8N + two-sided
# constant-factor ndjson log) lands in M5 when the probers exist. This skeleton
# establishes the machine-id + ndjson log convention so M5 plugs straight in.
set -u
cd "$(dirname "$0")" || exit 1
arch="$(uname -m)"; cpu="$(sysctl -n machdep.cpu.brand_string 2>/dev/null || uname -p)"
machine_id="$(printf '%s|%s' "$arch" "$cpu" | shasum -a 256 | cut -c1-12)"
mkdir -p bench
echo "bench machine-id: $machine_id  (log: bench/$machine_id.ndjson)" >&2
echo "No runtime benchmarks in M1 — detection probers arrive in M2+, full perf gate in M5." >&2
exit 0
