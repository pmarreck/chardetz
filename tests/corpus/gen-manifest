#!/usr/bin/env bash
# Generate tests/corpus/manifest.json from the labelled corpus.
# Label derivation: uppercase the filename up to the first dot (mirrors uchardet's
# own test convention, uchardet-tests.c: strtok(basename, ".")). So utf-16.be →
# UTF-16, utf-16be.txt → UTF-16BE, iso-8859-6.txt → ISO-8859-6, euc-kr.smi → EUC-KR.
# Rationale: uchardet reports the endianless family (UTF-16/UTF-32) for BOM-bearing
# files (the BOM conveys byte order at decode), so the expected label must match.
set -u
cd "$(dirname "$0")" || exit 1

out="manifest.json"
printf '[\n' > "$out"
first=1

for lang_dir in */; do
	lang="${lang_dir%/}"
	# Walk files inside this language dir (non-recursive; no subdirs expected).
	for fpath in "$lang_dir"*; do
		[ -f "$fpath" ] || continue
		fname="$(basename "$fpath")"
		# Label = filename up to the FIRST dot, uppercased — mirrors uchardet's own
		# test convention (uchardet-tests.c: strtok(basename, ".")). A BOM, when
		# present, conveys byte order at decode time, so uchardet reports the
		# endianless family (UTF-16 / UTF-32) for BOM-bearing .be/.le files; when
		# the endianness is encoded in the stem (utf-16be) it is preserved. Do NOT
		# fold .be/.le into the label — that diverges from what the oracle returns.
		stem="${fname%%.*}"
		label="$(printf '%s' "$stem" | tr 'a-z' 'A-Z')"
		rel="$lang/$fname"
		if [ "$first" -eq 1 ]; then
			first=0
		else
			printf ',\n' >> "$out"
		fi
		printf '  {"path": "%s", "label": "%s"}' "$rel" "$label" >> "$out"
	done
done

printf '\n]\n' >> "$out"
echo "manifest.json written ($(wc -l < "$out" | tr -d ' ') lines)"
