#!/usr/bin/env bash
# Bounded differential fuzz campaign: the seeded randomized differential from
# the oracle gate (generated, mutated, spliced, sliced and boundary-case inputs
# in random chunk sizes, C++ oracle vs chardetz) with a larger case count.
# `./test` runs the same harness with its default 20,000 cases.
#
# Usage:
#   ./fuzz                                  # 200,000 cases, default seed
#   CHARDETZ_FUZZ_CASES=1000000 ./fuzz
#   CHARDETZ_FUZZ_SEED=12345 ./fuzz         # any failure report names its seed
set -u
cd "$(dirname "$0")" || exit 1
cases="${CHARDETZ_FUZZ_CASES:-200000}"
seed="${CHARDETZ_FUZZ_SEED:-7163082351271310458}"
echo "fuzz: seed=$seed cases=$cases" >&2
exec nix develop -c zig build oracle-gate -Doptimize=ReleaseSafe -Dfuzz-seed="$seed" -Dfuzz-cases="$cases" --summary all
