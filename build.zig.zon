.{
    .name = .chardetz,
    .version = "0.2.0",
    .minimum_zig_version = "0.16.0",
    // The C++ oracle and corpus come from the flake input `uchardetz-src`
    // (see flake.nix); consumers of this package need no dependencies.
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
        "tools",
        "cli",
        "include",
        "bench",
        "COPYING",
        "PROVENANCE.md",
        "THIRD_PARTY_LICENSES",
    },
    // Zig-computed per-package fingerprint (low bits hash the package name).
    .fingerprint = 0xc27e58ace7e24623,
}
